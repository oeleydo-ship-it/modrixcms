{
    "name": "modrix/lumikin",
    "type": "theme",
    "display_name": "Lumikin",
    "description": "Bright, friendly kindergarten theme: white pages with a warm sand band, deep berry buttons, pastel cards, organic photo shapes, stacking activity cards and the Parkinsans font. Import the demo for Home, About, Programs, Fees, Blog and Contact plus its global header and footer.",
    "version": "1.0.0",
    "cms_version": "^1.0",
    "author": "Modrix",
    "license": "MIT",
    "screenshot": "public/screenshot.svg",
    "styles": ["public/theme.css"],
    "scripts": ["public/theme.js"],
    "design": {
        "primary": "#9a233d",
        "on_primary": "#ffffff",
        "primary_soft": "#c43a59",
        "secondary": "#151519",
        "accent": "#dadaf0",
        "heading": "#111111",
        "body": "#4d4d4d",
        "muted": "#6b6b6b",
        "background": "#ffffff",
        "surface": "#f6f2ed",
        "dark": "#151519",
        "on_dark": "#ffffff",
        "on_dark_muted": "#cfcfd6",
        "border": "#ebe6df",
        "header_bg": "#ffffff",
        "header_text": "#111111",
        "footer_bg": "#f6f2ed",
        "footer_text": "#4d4d4d",
        "heading_font": "Parkinsans",
        "body_font": "Parkinsans",
        "heading_weight": "500",
        "heading_tracking": "tight",
        "heading_line_height": "1.2",
        "line_height": "1.8",
        "eyebrow_style": "uppercase",
        "button_shape": "pill",
        "button_weight": "500",
        "button_hover": "lift",
        "header_height": "68",
        "header_blur": false,
        "nav_weight": "500",
        "nav_gap": "wide",
        "hero_glow": false,
        "hero_highlight": "plain",
        "badge_radius": "pill",
        "section_spacing": "roomy",
        "content_width": "1560",
        "card_radius": "extra",
        "card_padding": "roomy",
        "shadow": "soft",
        "link": "#9a233d",
        "link_hover": "#111111",
        "footer_padding": "roomy",
        "footer_border": false
    },
    "demo": {
        "header": "demo/header.json",
        "footer": "demo/footer.json",
        "pages": [
            { "title": "Home", "slug": "home", "file": "demo/home.json", "home": true, "menu": true },
            { "title": "About", "slug": "about", "file": "demo/about.json", "menu": true },
            { "title": "Programs", "slug": "programs", "file": "demo/programs.json", "menu": true },
            { "title": "Fees", "slug": "fees", "file": "demo/fees.json", "menu": true },
            { "title": "Blog", "slug": "stories", "file": "demo/stories.json", "menu": true },
            { "title": "Contact", "slug": "contact", "file": "demo/contact.json", "menu": true }
        ]
    },
    "settings": [
        { "name": "cta_label", "label": "Header button text", "type": "text", "default": "Schedule a visit" },
        { "name": "cta_url", "label": "Header button link", "type": "url", "default": "" },
        { "name": "footer_about", "label": "Footer description", "type": "textarea", "default": "Joyful early years education for curious little minds. We help every child learn, play and grow with confidence." },
        { "name": "address", "label": "Address (footer)", "type": "text", "default": "22 Willow Bend, Austin, TX 78704" },
        { "name": "phone", "label": "Phone (footer)", "type": "text", "default": "(555) 318-2040" }
    ]
}
