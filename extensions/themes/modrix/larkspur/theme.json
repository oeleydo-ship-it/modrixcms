{
    "name": "modrix/larkspur",
    "type": "theme",
    "display_name": "Larkspur Family Health",
    "version": "1.0.0",
    "description": "Calm family clinic theme with Instrument Sans headlines, Mulish body text and an ink-blue and copper palette. Includes a full-bleed photo hero with word-by-word headline reveals, a promise marquee, visit price tickets, tabbed care categories, clinic and clinician cards, an insurance and fee card, a review carousel, a tabbed FAQ and a booking band, plus 21 reusable blocks and 7 page templates, all editable in Theme settings.",
    "cms_version": "^1.0",
    "author": "Modrix",
    "license": "MIT",
    "styles": ["public/theme.css"],
    "scripts": ["public/theme.js"],
    "screenshot": "public/screenshot.svg",
    "settings": [],
    "design": {
        "primary": "#1a6083",
        "on_primary": "#ffffff",
        "primary_soft": "#e3edf5",
        "secondary": "#15394c",
        "accent": "#ca9352",
        "heading": "#4b545d",
        "body": "#575757",
        "muted": "#80888c",
        "background": "#ffffff",
        "surface": "#eef3f8",
        "dark": "#15394c",
        "on_dark": "#ffffff",
        "on_dark_muted": "#c2c8ce",
        "border": "#e1e4e8",
        "header_bg": "#ffffff",
        "header_text": "#2f2f2f",
        "footer_bg": "#353f49",
        "footer_text": "#c2c8ce",
