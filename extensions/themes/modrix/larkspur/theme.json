        "header_blur": false,
        "header_border": true,
        "nav_weight": "400",
        "nav_gap": "normal",
        "hero_padding": "tall",
        "hero_highlight": "plain",
        "badge_radius": "pill",
        "hero_glow": false,
        "section_spacing": "roomy",
        "content_width": "1280",
