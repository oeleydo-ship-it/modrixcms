{
    "name": "modrix/pebblewood",
    "type": "theme",
    "display_name": "Pebblewood",
    "description": "Warm and playful theme for nurseries, preschools and childcare centres: cream pages, deep teal bands, coral accents, pastel cards, pill buttons and the friendly Parkinsans font. Pairs with the Pebblewood page templates in the visual builder.",
    "version": "1.0.0",
    "cms_version": "^1.0",
    "author": "Modrix",
    "license": "MIT",
    "screenshot": "public/screenshot.svg",
    "styles": ["public/theme.css"],
    "scripts": ["public/theme.js"],
    "design": {
        "primary": "#1f1d3d",
        "on_primary": "#ffffff",
        "primary_soft": "#1f6b63",
        "secondary": "#1f6b63",
        "accent": "#ef7d45",
        "heading": "#1f1d3d",
        "body": "#5a5668",
        "muted": "#6f6a7d",
        "background": "#fffaf3",
        "surface": "#fbf3e2",
        "dark": "#1f6b63",
        "on_dark": "#ffffff",
        "on_dark_muted": "#cfe3df",
        "border": "#ece4d4",
        "header_bg": "#fffaf3",
        "header_text": "#1f1d3d",
        "footer_bg": "#fbf3e2",
        "footer_text": "#5a5668",
        "heading_font": "Parkinsans",
        "body_font": "Parkinsans",
        "heading_weight": "600",
        "heading_tracking": "tight",
        "heading_line_height": "1.2",
        "line_height": "1.8",
        "eyebrow_style": "none",
        "button_shape": "pill",
        "button_weight": "500",
        "button_hover": "lift",
        "header_height": "84",
        "header_blur": false,
        "nav_weight": "500",
        "nav_gap": "wide",
        "hero_glow": false,
        "hero_highlight": "plain",
        "badge_radius": "pill",
        "section_spacing": "roomy",
        "card_radius": "extra",
        "card_padding": "roomy",
        "section_radius": "round",
        "shadow": "soft",
        "link": "#ef7d45",
        "link_hover": "#1f6b63",
        "footer_padding": "roomy",
        "footer_border": false
    },
    "demo": {
        "header": "demo/header.json",
        "footer": "demo/footer.json",
        "pages": [
            { "title": "Home", "slug": "home", "file": "demo/home.json", "home": true, "menu": true, "site_header": false },
            { "title": "About us", "slug": "about", "file": "demo/about.json", "menu": true },
            { "title": "Programs", "slug": "programs", "file": "demo/programs.json", "menu": true },
            { "title": "Blog", "slug": "news", "file": "demo/news.json", "menu": true },
            { "title": "Contact", "slug": "contact", "file": "demo/contact.json", "menu": true }
        ]
    },
    "settings": [
        { "name": "show_announcement", "label": "Show the announcement bar", "type": "toggle", "default": true },
        { "name": "announcement_text", "label": "Announcement text", "type": "text", "default": "Little ones grow big here" },
        { "name": "announcement_link_label", "label": "Announcement link text", "type": "text", "default": "Book a visit" },
        { "name": "announcement_url", "label": "Announcement link", "type": "url", "default": "" },
        { "name": "phone", "label": "Phone number (shown in the header)", "type": "text", "default": "+1 (555) 214-7788" },
        { "name": "cta_label", "label": "Header button text", "type": "text", "default": "Book a visit" },
        { "name": "cta_url", "label": "Header button link", "type": "url", "default": "" },
        { "name": "footer_about", "label": "Footer description", "type": "textarea", "default": "We give every child a safe, warm and playful place to learn, make friends and grow in confidence." },
        { "name": "footer_badge", "label": "Footer note", "type": "text", "default": "Licensed early learning centre" }
    ]
}
