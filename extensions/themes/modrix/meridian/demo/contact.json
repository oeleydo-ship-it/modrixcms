RD00000000000000001BP","span":{"desktop":7,"tablet":12,"mobile":12},"style":[],"blocks":[{"id":"01J9MRD00000000000000001BG","type":"container","props":{"layout":"stack","gap":"0px","meridianRole":"faq-list"},"style":[],"children":[{"id":"01J9MRD00000000000000001BH","type":"faq","props":{"initialOpen":true,"items":[{"question":"How early before relocating should we engage Meridian?","answer":"Ideally 8 to 14 weeks prior to your intended start date. This leaves buffer for apostilles, employer sponsor allocations and consular biometrics slots without rush fees."},{"question":"Do you work with corporate HR teams or individual applicants?","answer":"Both. Around half of our practice supports founders and senior individuals directly, while the remainder acts as an embedded mobility desk for scaling technology and engineering companies."},{"question":"Can spouses and children be filed in the same dossier cycle?","answer":"Yes. Where statutory rules allow concurrent filing, we synchronize principal and dependant evidence—including school placements and marriage legalisations—so households travel together."},{"question":"What happens if an application previously received a refusal?","answer":"We conduct a written refusal audit first to establish whether an administrative review or a restructured re-application with fresh documentary evidence offers the strongest path."},{"question":"Are legal fees fixed per stage rather than open hourly retainers?","answer":"Every route comes with a fixed written milestone fee agreed before work begins, separated transparently from mandatory government and biometric tariffs."},{"question":"How does your team manage document translation and apostilles?","answer":"We coordinate certified translations and Hague Convention apostilles across forty-two civil registries so documents meet exact consular format on first submission."}],"allowMultipleOpen":false,"emitSchemaOrg":true},"style":[]}]}]}]}],"settings":{"designCollection":"meridian","designBlock":"faq"}}]}