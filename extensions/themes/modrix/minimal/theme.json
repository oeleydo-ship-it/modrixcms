{
    "name": "modrix/minimal",
    "type": "theme",
    "display_name": "Minimal",
    "description": "Quiet and editorial: black and white with one accent colour, serif headlines, its own header and call-to-action block, and square corners.",
    "version": "1.1.0",
    "cms_version": "^1.0",
    "author": "Modrix",
    "license": "MIT",
    "screenshot": "public/screenshot.svg",
    "styles": ["public/theme.css"],
    "scripts": ["public/theme.js"],
    "design": {
        "primary": "#e4572e",
        "primary_soft": "#e4572e",
        "secondary": "#111111",
        "accent": "#e4572e",
        "heading": "#111111",
        "body": "#222222",
        "muted": "#666666",
        "background": "#ffffff",
        "surface": "#ffffff",
        "dark": "#111111",
        "border": "#e5e5e5",
        "header_bg": "#ffffff",
        "header_text": "#111111",
        "footer_bg": "#ffffff",
        "footer_text": "#666666",
        "link": "#e4572e",
        "link_hover": "#111111",
        "heading_font": "Georgia",
        "body_font": "Inter",
        "heading_weight": "600",
        "button_shape": "square",
        "card_radius": "square",
        "shadow": "none",
        "hero_glow": false,
        "card_hover": false
    },
    "settings": [
        { "name": "show_cta", "label": "Show the button in the header", "type": "toggle", "default": true },
        { "name": "cta_label", "label": "Header button text", "type": "text", "default": "Get started" },
        { "name": "cta_url", "label": "Header button link", "type": "url", "default": "" }
    ]
}
