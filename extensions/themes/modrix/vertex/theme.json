{
    "name": "modrix/vertex",
    "type": "theme",
    "display_name": "Vertex Enterprise",
    "version": "1.0.0",
    "description": "A clean, plain theme for presenting Modrix Commerce, the free open-source e-commerce platform. It has a header with drop-down menus, a navy hero, highlight cards, a feature grid, a filterable list of example modules and an install page, plus six example pages you can import in one click. Colors, fonts and the top link bar can be changed in Theme settings and Customize.",
    "cms_version": "^1.0",
    "author": "Modrix",
    "license": "MIT",
    "styles": [
        "public/theme.css"
    ],
    "scripts": [
        "public/theme.js"
    ],
    "screenshot": "public/screenshot.svg",
    "settings": [
        {
            "name": "hero_end",
            "type": "color",
            "label": "Hero Gradient End Color",
            "default": "#165187",
            "css_var": "--vertex-hero-end"
        },
        {
            "name": "banner_bg",
            "type": "color",
            "label": "Announcement Strip Color",
            "default": "#005f87",
            "css_var": "--vertex-banner-bg"
        },
        {
            "name": "stripe_start",
            "type": "color",
            "label": "Footer Stripe Start Color",
            "default": "#6cc04a",
            "css_var": "--vertex-stripe-start"
        },
        {
            "name": "stripe_end",
            "type": "color",
            "label": "Footer Stripe End Color",
            "default": "#5b3df5",
            "css_var": "--vertex-stripe-end"
        },
        {
            "name": "show_utility_bar",
            "type": "toggle",
            "label": "Show the Top Link Bar",
            "default": true,
            "css_var": "--vertex-utility-display",
            "css_values": {
                "1": "block",
                "0": "none"
            }
        }
    ],
    "design": {
        "primary": "#006994",
        "on_primary": "#ffffff",
        "primary_soft": "#e5f2f8",
        "secondary": "#00a99d",
        "accent": "#5b3df5",
        "heading": "#2d3748",
        "body": "#596573",
        "muted": "#718096",
        "background": "#ffffff",
        "surface": "#eef2f5",
        "dark": "#0c2340",
        "on_dark": "#ffffff",
        "on_dark_muted": "#cbdcf0",
        "border": "#dce3ec",
        "header_bg": "#ffffff",
        "header_text": "#2d3748",
        "footer_bg": "#ffffff",
        "footer_text": "#4a5565",
        "link": "#006994",
        "link_hover": "#0c2340",
        "heading_font": "Plus Jakarta Sans",
        "body_font": "Plus Jakarta Sans",
        "base_size": "16",
        "heading_scale": "normal",
        "heading_weight": "400",
        "heading_line_height": "1.2",
        "heading_tracking": "tight",
        "line_height": "1.6",
        "eyebrow_style": "uppercase",
        "button_shape": "square",
        "button_size": "md",
        "button_style": "filled",
        "button_weight": "600",
        "button_border_width": "1px",
        "button_hover": "none",
        "header_height": "84",
        "header_sticky": true,
        "header_blur": false,
        "header_border": true,
        "nav_weight": "500",
        "nav_gap": "normal",
        "hero_padding": "tall",
        "hero_highlight": "plain",
        "badge_radius": "square",
        "hero_glow": false,
        "section_spacing": "roomy",
        "content_width": "1280",
        "grid_gap": "wide",
        "card_radius": "soft",
        "card_padding": "normal",
        "section_radius": "none",
        "shadow": "soft",
        "card_hover": true,
        "link_underline": false,
        "footer_padding": "roomy",
        "footer_border": false
    },
    "demo": {
        "header": "demo/header.json",
        "footer": "demo/footer.json",
        "pages": [
            {
                "title": "Home",
                "slug": "home",
                "file": "demo/home.json",
                "home": true,
                "menu": true,
                "site_header": true,
                "site_footer": true
            },
            {
                "title": "Features",
                "slug": "platform",
                "file": "demo/platform.json",
                "menu": true,
                "site_header": true,
                "site_footer": true
            },
            {
                "title": "Themes & modules",
                "slug": "modules",
                "file": "demo/modules.json",
                "menu": true,
                "site_header": true,
                "site_footer": true
            },
            {
                "title": "Use cases",
                "slug": "solutions",
                "file": "demo/solutions.json",
                "menu": true,
                "site_header": true,
                "site_footer": true
            },
            {
                "title": "Get started",
                "slug": "developers",
                "file": "demo/developers.json",
                "menu": true,
                "site_header": true,
                "site_footer": true
            },
            {
                "title": "Demo",
                "slug": "demo",
                "file": "demo/demo.json",
                "menu": true,
                "site_header": true,
                "site_footer": true
            }
        ]
    }
}
